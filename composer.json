{
  "name": "ignf/validator-api",
  "description": "APIsation of Validator, a tool that allows to validate and normalize datasets according to a file mapping and a FeatureCatalog.",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.5",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-zip": "*",
    "ext-pcntl": "*",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.7",
    "jms/serializer-bundle": "^5.0",
    "justinrainbow/json-schema": "^6.0",
    "nelmio/cors-bundle": "^2.1",
    "symfony/apache-pack": "^1.0",
    "symfony/asset": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/filesystem": "7.4.*",
    "symfony/flex": "^2.4",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-foundation": "7.4.*",
    "symfony/monolog-bundle": "^4.0",
    "symfony/process": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/yaml": "7.4.*",
    "symfony/mime": "7.4.*",
    "symfony/runtime": "7.4.*",
    "league/flysystem-bundle": "^3.3",
    "league/flysystem-async-aws-s3": "^3.29",
    "symfony/polyfill-php86": "^1.37",
    "dompdf/dompdf": "^3.1",
    "symfony/rate-limiter": "7.4.*"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.0",
    "liip/functional-test-bundle": "^4.5",
    "liip/test-fixtures-bundle": "^3.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^13.0",
    "symfony/browser-kit": "7.4.*",
    "symfony/maker-bundle": "^1.52",
    "symfony/phpunit-bridge": "7.4.*",
    "symfony/stopwatch": "7.4.*",
    "symfony/web-profiler-bundle": "7.4.*",
    "php-coveralls/php-coveralls": "^2.5",
    "symfony/css-selector": "7.4.*"
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": false,
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
      "psr-4": {
          "App\\Tests\\": "tests/"
      }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php83": "*",
    "symfony/polyfill-php84": "*",
    "symfony/polyfill-php85": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts",
      "sh bin/install-validator.sh"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  },
  "repositories": {}
}
