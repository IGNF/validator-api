{
  "name": "ignf/validator-api",
  "description": "APIsation of Validator, a tool that allows to validate and normalize datasets according to a file mapping and a FeatureCatalog.",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.5",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-zip": "*",
    "ext-pcntl": "*",
    "composer/package-versions-deprecated": "^1.11",
    "doctrine/doctrine-bundle": "^2.1",
    "doctrine/doctrine-migrations-bundle": "^3.0",
    "doctrine/orm": "^3.7",
    "jms/serializer-bundle": "^5.0",
    "justinrainbow/json-schema": "^5.2",
    "nelmio/cors-bundle": "^2.1",
    "symfony/apache-pack": "^1.0",
    "symfony/asset": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/filesystem": "7.4.*",
    "symfony/flex": "^2.4",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-foundation": "7.4.*",
    "symfony/monolog-bundle": "^3.6",
    "symfony/process": "7.4.*",
    "symfony/requirements-checker": "^2.0",
    "symfony/twig-bundle": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/yaml": "7.4.*",
    "symfony/mime": "7.4.*",
    "symfony/runtime": "7.4.*",
    "league/flysystem-bundle": "^3.3",
    "league/flysystem-async-aws-s3": "^3.29",
    "league/flysystem-aws-s3-v3": "^3.29",
    "knplabs/knp-snappy-bundle": "^1.10"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^3.4",
    "liip/functional-test-bundle": "^4.5",
    "liip/test-fixtures-bundle": "^2.4",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpmd/phpmd": "^2.10",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^11.0",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/maker-bundle": "^1.52",
    "symfony/phpunit-bridge": "7.4.*",
    "symfony/stopwatch": "7.4.*",
    "symfony/web-profiler-bundle": "7.4.*",
    "php-coveralls/php-coveralls": "^2.5"
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": false,
    "secure-http": false,
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
      "psr-4": {
          "App\\Tests\\": "tests/"
      }
  },
  "replace": {
    "paragonie/random_compat": "2.*",
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php71": "*",
    "symfony/polyfill-php70": "*",
    "symfony/polyfill-php56": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd",
      "requirements-checker": "script"
    },
    "post-install-cmd": [
      "@auto-scripts",
      "curl -Lo bin/validator-cli.jar https://github.com/IGNF/validator/releases/download/v4.5.6/validator-cli.jar"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  },
  "repositories": {}
}
