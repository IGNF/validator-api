{% set bodyclass = (bodyclass|default('')) %}
{% set hasNavLeft = (hasNavLeft|default(0)) %}
{% set sidebarLeft = (sideBarLeft|default(0)) %}
{% set sidebarRight = (sidebarRight|default(0)) %}
{% set hasBreadcrumb = (hasBreadcrumb|default(0)) %}

<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <meta http-equiv="x-ua-compatible" content="ie=edge"/>
        {% block meta %} {% endblock %}

        <title>
            {% block title %}API Validator - IGN{% endblock %}
        </title>

        <link rel="icon" type="image/x-icon" href="{{ asset('img/favicon.ico') }}"/>

        {% block stylesheets %}
            {# style-carto.css (from validator-api-client) includes Bootstrap 4 #}
            <link rel="stylesheet" href="{{ asset('css/style-carto.css') }}"/>
        {% endblock %}
    </head>

    <body class="{{ bodyclass }}">
        <div id="demo-wrapper"
             class="body-wrapper {% if hasNavLeft %} layout-navLeft{% else %} layout-default{% endif %}{% if sidebarLeft %} layout-sidebarLeft{% endif %}{% if sidebarRight %} layout-sidebarRight{% endif %}{% if bodyclass %} {{ bodyclass }}{% endif %}"
             data-specs="{{ path('validator_api_swagger') }}"
             data-api="{{ path('validator_api_root') }}"
             >
            {% block body %} {% endblock %}
        </div>

        {% block javascripts %}{% endblock %}
    </body>
</html>
